+// Out of memory ([new.delete.single]): call the installed std::new_handler
+// and try again, and throw std::bad_alloc only once there is none. Throwing at
+// once gave bad_alloc to a program whose handler frees a cache. The nothrow
+// forms return nullptr for whatever the handler throws, as libstdc++'s do.
+// The handler may allocate, so the caller's routing hint is put back before
+// each retry. `al` 0: plain xxmalloc.
+__attribute__((noinline, cold)) static void* alloc8_new_retry(std::size_t sz, std::size_t al) {
+  void* const ra = alloc8_caller_ra;
+  for (;;) {
+    const std::new_handler handler = std::get_new_handler();
+    if (!handler) throw std::bad_alloc();
+    handler();
+    alloc8_caller_ra = ra;
+    if (void* ptr = al ? xxmemalign(al, sz) : xxmalloc(sz)) return ptr;
+  }
+}
+
+__attribute__((noinline, cold)) static void* alloc8_new_retry_nothrow(std::size_t sz,
+                                                                     std::size_t al) noexcept {
+  try {
+    return alloc8_new_retry(sz, al);
+  } catch (...) {
+    return nullptr;
+  }
+}
+
