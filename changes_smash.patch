+                for (uintptr_t x = regs[k].start; x < regs[k].end; x += kPageSize)
+                    on_written(x);
+            if (a.walk_end <= a.start || a.walk_end >= a.end) break;
+            a.start = a.walk_end;
+        }
+        return true;
+    }
