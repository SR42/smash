+++          "userfaultfd (vm::g_after_remap_track_hook)", remap_compressed_at);
+++
+++    if (failures) { printf("uffd_write_tracking_test: %d FAILURES\n", failures); return 1; }
+++    printf("uffd_write_tracking_test: all checks passed\n");
+++    return 0;
+++}
