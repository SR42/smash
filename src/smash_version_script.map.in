# Smash version script for Linux
# Extends alloc8's version script with syscall wrapper symbols.
# The GLIBC base version is substituted at configure time — see
# CMakeLists.txt. Picking too low a base leaves the LD_PRELOAD'd malloc
# bypassed on archs whose minimum malloc version is higher (aarch64
# binaries link against malloc@GLIBC_2.17, so exporting only @GLIBC_2.2.5
# loses to libc).

@SMASH_GLIBC_BASE_VERSION@ {
  global:
    # Signal handler installation: SIGSEGV/SIGBUS handlers become smash's
    # chained handlers instead of replacing smash's (linux_syscall_wrappers.cpp)
    sigaction;
    __sigaction;
    sigaltstack;
    signal;
    bsd_signal;
    ssignal;
    sysv_signal;
    __sysv_signal;
    sigset;

    # Core allocation functions (from alloc8)
    malloc;
    free;
    calloc;
    realloc;
    memalign;
    posix_memalign;
@SMASH_ALIGNED_ALLOC_IN_BASE@
    free_sized;
    free_aligned_sized;
    malloc_usable_size;
    strdup;
    strndup;
    valloc;
    pvalloc;
    reallocarray;
    cfree;
    mallopt;
    malloc_trim;
    malloc_stats;
    mallinfo;
    __libc_malloc;
    __libc_free;
    __libc_calloc;
    __libc_realloc;
    __libc_memalign;

    # C++ operators
    _Znwm;
    _Znam;
    _ZdlPv;
    _ZdaPv;
    _ZnwmRKSt9nothrow_t;
    _ZnamRKSt9nothrow_t;
    _ZdlPvRKSt9nothrow_t;
    _ZdaPvRKSt9nothrow_t;
    _ZdlPvm;
    _ZdaPvm;
    _ZnwmSt11align_val_t;
    _ZnamSt11align_val_t;
    _ZdlPvSt11align_val_t;
    _ZdaPvSt11align_val_t;
    _ZdlPvmSt11align_val_t;
    _ZdaPvmSt11align_val_t;

    # xxmalloc interface
    xxmalloc;
    xxfree;
    xxfree_sized;
    xxfree_aligned_sized;
    xxrealloc;
    xxcalloc;
    xxmemalign;
    xxmalloc_usable_size;
    xxmalloc_lock;
    xxmalloc_unlock;

    # Thread lifecycle hooks
    pthread_create;
    pthread_exit;
    xxthread_init;
    xxthread_cleanup;
    xxthread_created_flag;

    # Diagnostic / test hooks (not interposers). smash_arena_for(ptr) returns
    # the arena a smash-managed pointer routed to; test_arena_routing uses it
    # to guard the call-site-arena invariant.
    smash_arena_for;
    smash_in_arena;
    smash_page_info;
    smash_run_cache_info;
    smash_release_hook_info;
    smash_subarena_pressure;
    smash_early_arena_info;
    smash_resilience_info;
    smash_debug_hold_locks;
    smash_fork_lock_info;
    smash_debug_hold_page_lock;
    smash_snapshot_info;
    smash_numa_route_info;
    smash_tick_budget_info;
    smash_worker_balance_info;
    smash_work_share_info;
    smash_write_tracker;
    smash_tick_cost_info;
    smash_thp_unit_info;
    smash_idle_scan_info;
    smash_blob_usage;
    smash_subarena_info;
    smash_shared_arena_info;

    # Public NUMA allocation API (include/smash/smash.h).
    malloc_numa;
    malloc_numa_aligned;
    smash_numa_arena_info;

    # Diagnostic / test hooks for the NUMA compressor groups
    # (test_numa_compressor).
    smash_numa_compressor_info;
    smash_compressed_blob_for;

    # alloc8 getcwd hooks (function pointers set by Smash constructor)
    xx_getcwd_prepare_hook;
    xx_getcwd_finish_hook;

    # Buffered I/O wrappers (glibc internal __read bypasses our read wrapper)
    fread;
    fgets;
    fgetc;
    getc;
    fwrite;
    fflush;

    # Smash syscall wrappers for kernel buffer access
    read;
    write;
    pread;
    pwrite;
    readv;
    writev;
    recv;
    send;
    recvfrom;
    sendto;
    recvmsg;
    sendmsg;
    poll;
    ppoll;
    select;
    pselect;
    accept;
    accept4;
    recvmmsg;
    sendmmsg;
    getsockopt;
    getsockname;
    getpeername;
    getrandom;
    epoll_wait;
    epoll_pwait;

    # The __*_chk wrappers, but only where the base version is the one their
    # callers bind (aarch64, where all of glibc is GLIBC_2.17). Empty on
    # x86-64, where they are exported by the GLIBC_2.4 / 2.5 / 2.16 nodes
    # below and the bare names must stay local.
@SMASH_CHK_BASE_EXPORTS@

    # Round 6: the syscalls the 2026-09-16 audit found still returning the
    # kernel's EFAULT to the application (agents/syscall-compat.md).
    epoll_ctl;
    ioctl;
    bind;
    setsockopt;
    sendfile;
    sendfile64;
    process_vm_readv;
    process_vm_writev;
    mincore;
    uname;
    sysinfo;
    statfs;
    statfs64;
    getrlimit;
    setrlimit;
    getgroups;
    getcpu;
    prctl;
    sigprocmask;
    pthread_sigmask;
    nanosleep;
    clock_nanosleep;
    utimensat;
    pipe;
    pipe2;
    socketpair;

    # mmap/munmap interposition for SMASH_TRACK_EXTERNAL
    mmap;
    mmap64;
    munmap;
    mremap;

    # fstat / stat family — glibc remaps fstat → fstat64 with
    # _FILE_OFFSET_BITS=64 (Ubuntu C++ default); glibc < 2.33 routes through
    # __fxstat / __xstat / __lxstat / __fxstatat (and _64 variants). Cover
    # all the entry points so LD_PRELOAD wins regardless of glibc version
    # or LFS settings.
    fstat;
    fstat64;
    stat;
    stat64;
    lstat;
    lstat64;
    fstatat;
    fstatat64;
    statx;
    __fxstat;
    __fxstat64;
    __xstat;
    __xstat64;
    __lxstat;
    __lxstat64;
    __fxstatat;
    __fxstatat64;
    fstatfs;

    # Directory enumeration + symlink reads (Round 2 coverage)
    getdents64;
    readlink;
    readlinkat;

    # Positioned vectored I/O (Round 3 coverage)
    preadv;
    pwritev;
    preadv2;
    pwritev2;

    # Process management (Round 4 coverage). glibc's waitpid, wait and wait3
    # call an internal wait4 that never reaches the wrapper above, so they
    # are wrapped themselves (all base-version symbols).
    waitid;
    wait4;
    waitpid;
    wait;
    wait3;

    # statvfs / xattr / rusage / rlimit (Round 5 coverage)
    statvfs;
    fstatvfs;
    getxattr;
    lgetxattr;
    fgetxattr;
    listxattr;
    llistxattr;
    flistxattr;
    getrusage;
    prlimit64;

    # getcwd wrapper (buffer write from kernel)
    getcwd;

    # CPU affinity: the kernel reads (set) or writes (get) a cpu_set_t that
    # thread pools routinely keep on the heap.
    sched_setaffinity;
    sched_getaffinity;
    # glibc's pthread_*affinity_np call the kernel through an internal
    # __sched_setaffinity, so the sched_* wrappers above never see them.
    pthread_setaffinity_np;
    pthread_getaffinity_np;

    # execve / execv* — pre-warm argv/envp pages before exec, so the
    # kernel can read them after the new image takes over (these are
    # one-shot syscalls; no EFAULT-retry possible).
    execve;
    execv;
    execvp;
    execvpe;

    # posix_spawn / posix_spawnp — Python 3.8+'s subprocess module uses
    # these (default when close_fds=True) instead of fork+exec. Same
    # warm-then-call pattern as execve.
    posix_spawn;
    posix_spawnp;

    # TBB scalable_allocator interposition
    # Allows Smash to manage TBB's memory allocations by intercepting its
    # internal allocator calls (TBB uses these for its 64MB per-thread arenas)
    scalable_malloc;
    scalable_free;
    scalable_realloc;
    scalable_calloc;
    scalable_posix_memalign;
    scalable_aligned_malloc;
    scalable_aligned_free;
    scalable_aligned_realloc;
    scalable_msize;

    # TBB memory pool functions
    pool_malloc;
    pool_free;
    pool_realloc;
    pool_aligned_malloc;
    pool_aligned_realloc;
    pool_identify;
    pool_msize;
    pool_create_v1;
    pool_destroy;
    pool_reset;

    # TBB cache_aligned_allocate interposition: REMOVED.
    # libtbb dispatches its allocate/deallocate through internal function-pointer
    # handlers. Interposing only the public symbols catches cross-DSO calls but
    # not TBB-internal calls; the resulting alloc/free mismatch corrupts the heap
    # ("double free or corruption (out)" / "munmap_chunk(): invalid pointer" in
    # neuron-cc Tensorizer subprocesses). Letting TBB use its own allocator is
    # safer; we lose visibility into TBB allocations but they're not the bulk of
    # neuron-cc's footprint. (See linux_syscall_wrappers.cpp for matching removal.)
    # _ZN3tbb6detail2r122cache_aligned_allocateEm;
    # _ZN3tbb6detail2r124cache_aligned_deallocateEPv;

  local:
    *;
};

# _FORTIFY_SOURCE rewrites a call whose destination size is known at compile
# time into the __*_chk alias, so a program built with hardening on (the
# default on Ubuntu/Fedora/RHEL) never references the plain symbol and the
# EFAULT decompress-and-retry wrappers never run. glibc versions these at
# GLIBC_2.4, 2.5 and 2.16, and callers bind those exact versions — exporting
# them at the base version alone would lose to libc, exactly as it did for
# sched_setaffinity and pthread_create below.
#
# The EFAULT-retry family, plus __fgets_chk / __fread_chk, which route a
# call that cannot overflow to the fgets / fread wrappers (their warm and
# retry); __getcwd_chk is not wrapped.
# Export ONLY the _NN aliases here, never the bare __*_chk names. Exporting
# both makes libsmash define two symbols matching the same name and version —
# __recv_chk@@GLIBC_2.4 (the wrapper) and __recv_chk@GLIBC_2.4 (the alias) —
# and the dynamic linker resolves the versioned reference to the exact-version
# match, i.e. the alias. The alias is a tail call `jmp __recv_chk@plt`, whose
# GOT slot then points back at the alias: a jump to itself. Measured directly —
# the GOT slot held the forwarder's address, and perf put 83% of cycles in
# __recv_chk@GLIBC_2.4 while the process spun at 100% CPU.
#
# The static relocation looks correct (it names the @@ wrapper), so .rela.plt
# does not reveal this; only the runtime GOT value does.
#
# With the bare names unlisted they fall under `local: *`, so the alias's
# internal call binds directly to the wrapper with no PLT and no loop, while
# applications still bind __recv_chk@GLIBC_2.4 to the alias as intended.
GLIBC_2.4 {
  global:
    __read_chk_24;
    __pread_chk_24;
    __pread64_chk_24;
    __recv_chk_24;
    __recvfrom_chk_24;
    __readlink_chk_24;
    __getgroups_chk_24;
    __fgets_chk_24;
    ppoll_24;
    readlinkat_24;
    __fxstatat_24;
    __fxstatat64_24;
} @SMASH_GLIBC_BASE_VERSION@;

GLIBC_2.5 {
  global:
    __readlinkat_chk_25;
} GLIBC_2.4;

GLIBC_2.7 {
  global:
    __fread_chk_27;
} GLIBC_2.5;

GLIBC_2.16 {
  global:
    __poll_chk_216;
    __ppoll_chk_216;
    # glibc versions aligned_alloc at GLIBC_2.16, so a caller binds
    # aligned_alloc@GLIBC_2.16 and a base-node-only export never runs — ld.so
    # silently uses libc's, and the block is never tracked or compressed
    # (measured: smash_arena_for() said NO for aligned_alloc while
    # posix_memalign, memalign and valloc were all smash-owned). Substituted
    # empty where the arch's ABI baseline is already >= 2.16 (aarch64,
    # GLIBC_2.17), because there the bare name in the base node is what
    # callers bind and exporting it twice is the self-jump trap below.
@SMASH_ALIGNED_ALLOC_IN_216@
} GLIBC_2.7;

# libevent requests epoll_wait@GLIBC_2.3.2
# Aliases epoll_wait_232/epoll_pwait_232 provide these versioned symbols
GLIBC_2.3.2 {
  global:
    epoll_wait;
    epoll_ctl;
    epoll_wait_232;
    epoll_ctl_232;
} @SMASH_GLIBC_BASE_VERSION@;

# The rest of the Round 6 wrappers whose glibc version is above the base one.
# Same rule as everywhere else here: a wrapper only wins if it is exported at
# the version the caller binds, and x86-64 glibc versions these above
# GLIBC_2.2.5. On aarch64 every one of them sits at the base GLIBC_2.17, which
# the bare names above already cover.
GLIBC_2.3 {
  global:
    sendfile64;
    sendfile64_23;
    getxattr_23;
    lgetxattr_23;
    fgetxattr_23;
    listxattr_23;
    llistxattr_23;
    flistxattr_23;
} @SMASH_GLIBC_BASE_VERSION@;

GLIBC_2.6 {
  global:
    utimensat;
    utimensat_26;
    epoll_pwait_26;
} GLIBC_2.3;

GLIBC_2.9 {
  global:
    pipe2;
    pipe2_29;
} GLIBC_2.6;

GLIBC_2.15 {
  global:
    process_vm_readv;
    process_vm_writev;
    process_vm_readv_215;
    process_vm_writev_215;
    posix_spawn_215;
    posix_spawnp_215;
} GLIBC_2.9;

GLIBC_2.29 {
  global:
    getcpu;
    getcpu_229;
} GLIBC_2.15;

# clock_nanosleep is the one case where the version x86-64 glibc uses is also
# aarch64's base version, so the node would be defined twice there. CMake
# leaves this empty on aarch64, where the base node already carries the name.
@SMASH_GLIBC_212_214_NODES@

@SMASH_GLIBC_217_NODE@

# glibc 2.34 re-versioned fstat / fstat64 to GLIBC_2.33 for y2038-safe
# struct stat. C++ binaries built against modern glibc reference
# fstat@GLIBC_2.33 specifically; if we only export fstat@GLIBC_2.2.5
# the dynamic linker doesn't match and our wrapper is bypassed.
# Export at both versions so we win regardless of binding age.
GLIBC_2.28 {
  global:
    statx;
    statx_228;
} @SMASH_GLIBC_BASE_VERSION@;

GLIBC_2.10 {
  global:
    preadv;
    pwritev;
    preadv_210;
    pwritev_210;
    accept4_210;
} @SMASH_GLIBC_BASE_VERSION@;

GLIBC_2.26 {
  global:
    preadv2;
    pwritev2;
    preadv2_226;
    pwritev2_226;
    reallocarray_226;
} GLIBC_2.10;
# Wrappers glibc versions above the base (symbol_version_test sweeps them all).
GLIBC_2.11 {
  global:
    execvpe_211;
} @SMASH_GLIBC_BASE_VERSION@;
GLIBC_2.13 {
  global:
    prlimit64_213;
} @SMASH_GLIBC_BASE_VERSION@;
GLIBC_2.25 {
  global:
    getrandom_225;
} @SMASH_GLIBC_BASE_VERSION@;

GLIBC_2.30 {
  global:
    getdents64;
    getdents64_230;
} GLIBC_2.28;

GLIBC_2.33 {
  global:
    fstat;
    fstat64;
    stat;
    stat64;
    lstat;
    lstat64;
    fstatat;
    fstatat64;
    fstat_233;
    fstat64_233;
    stat_233;
    stat64_233;
    lstat_233;
    lstat64_233;
    fstatat_233;
    fstatat64_233;
} @SMASH_GLIBC_BASE_VERSION@;

# CPU affinity. glibc exports sched_*@GLIBC_2.3.4,
# pthread_setaffinity_np@GLIBC_2.34 and pthread_getaffinity_np@GLIBC_2.32, and
# callers bind those exact versions — base-version definitions alone lose to
# libc (measured: the wrappers never ran until these sections existed). The
# *_234 / *_232 aliases carry .symver directives in linux_syscall_wrappers.cpp.
GLIBC_2.3.4 {
  global:
    sched_setaffinity;
    sched_getaffinity;
    sched_setaffinity_234;
    sched_getaffinity_234;
} @SMASH_GLIBC_BASE_VERSION@;

GLIBC_2.32 {
  global:
    pthread_getaffinity_np;
    pthread_getaffinity_np_232;
    pthread_sigmask;
    pthread_sigmask_232;
} @SMASH_GLIBC_BASE_VERSION@;

GLIBC_2.34 {
  global:
    pthread_setaffinity_np;
    pthread_setaffinity_np_234;
    # glibc 2.34 merged libpthread into libc and made GLIBC_2.34 the default
    # version for these two. Exported only at the base version, alloc8's
    # thread interposer never saw an application thread on any glibc >= 2.34.
    pthread_create;
    pthread_exit;
    pthread_create_234;
    pthread_exit_234;
} GLIBC_2.32;

# C++ operator new/delete with libstdc++ versioning
# libBIR.so and other walrus libraries request these versions, not GLIBC_2.2.5.
# Without these, LD_PRELOAD interposition fails to capture C++ allocations,
# and walrus's statically-linked tcmalloc wins → cross-allocator corruption.
# The wrapper functions (*_GLIBCXX_3_4, *_CXXABI_1_3_*) are defined in
# linux_syscall_wrappers.cpp with .symver directives to create versioned aliases.
GLIBCXX_3.4 {
  global:
    _Znwm;
    _Znam;
    _ZdlPv;
    _ZdaPv;
    _ZnwmRKSt9nothrow_t;
    _ZnamRKSt9nothrow_t;
    _ZdlPvRKSt9nothrow_t;
    _ZdaPvRKSt9nothrow_t;
    # Wrapper functions that will be aliased via .symver
    _Znwm_GLIBCXX_3_4;
    _Znam_GLIBCXX_3_4;
    _ZdlPv_GLIBCXX_3_4;
    _ZdaPv_GLIBCXX_3_4;
    _ZnwmRKSt9nothrow_t_GLIBCXX_3_4;
    _ZnamRKSt9nothrow_t_GLIBCXX_3_4;
    _ZdlPvRKSt9nothrow_t_GLIBCXX_3_4;
    _ZdaPvRKSt9nothrow_t_GLIBCXX_3_4;
} @SMASH_GLIBC_BASE_VERSION@;

CXXABI_1.3.9 {
  global:
    _ZdlPvm;
    _ZdaPvm;
    _ZdlPvm_CXXABI_1_3_9;
    _ZdaPvm_CXXABI_1_3_9;
} GLIBCXX_3.4;

CXXABI_1.3.11 {
  global:
    _ZnwmSt11align_val_t;
    _ZnamSt11align_val_t;
    _ZdlPvSt11align_val_t;
    _ZdaPvSt11align_val_t;
    _ZdlPvmSt11align_val_t;
    _ZdaPvmSt11align_val_t;
    _ZnwmSt11align_val_tRKSt9nothrow_t;
    _ZnamSt11align_val_tRKSt9nothrow_t;
    _ZnwmSt11align_val_t_CXXABI_1_3_11;
    _ZnamSt11align_val_t_CXXABI_1_3_11;
    _ZdlPvSt11align_val_t_CXXABI_1_3_11;
    _ZdaPvSt11align_val_t_CXXABI_1_3_11;
    _ZdlPvmSt11align_val_t_CXXABI_1_3_11;
    _ZdaPvmSt11align_val_t_CXXABI_1_3_11;
    _ZnwmSt11align_val_tRKSt9nothrow_t_CXXABI_1_3_11;
    _ZnamSt11align_val_tRKSt9nothrow_t_CXXABI_1_3_11;
    _ZdlPvSt11align_val_tRKSt9nothrow_t_CXXABI_1_3_11;
    _ZdaPvSt11align_val_tRKSt9nothrow_t_CXXABI_1_3_11;
} CXXABI_1.3.9;
